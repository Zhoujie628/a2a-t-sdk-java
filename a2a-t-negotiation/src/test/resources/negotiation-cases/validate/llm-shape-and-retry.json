    "expect": {
      "outcome": "success",
      "llmCalls": 2,
      "params": {
        "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3",
        "round": 2,
        "maxRounds": 5,
        "region": "Songshan Lake"
      },
      "contracts": ["contextKeysInMergedParams"]
    }
  },
