[
  {
    "id": "SC-FSB-01",
    "summary": "可行性协商单轮闭环：A 发起调整后速率保障目标的可行性评估请求，B 评估通过后生成接受消息，A 校验确认达成一致",
    "languages": ["zh-CN", "en-US"],
    "roles": ["A", "B"],
    "steps": [
      {
        "step": 1,
        "role": "A",
        "api": "generateProposeFromText",
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 1, "maxRounds": 5 },
        "templateUri": "Negotiation-T/feasibility-negotiation/propose/v1",
        "input": {
          "text": {
            "zh-CN": "请评估站点级节能任务调整后的速率保障目标是否可行：节能期间速率保障目标由5Mbps下调至2Mbps，且停电场景下供电时长不少于10小时。",
            "en-US": "Please assess whether the adjusted rate guarantee target of the site-level energy-saving task can be achieved: the rate guarantee target is lowered from 5Mbps to 2Mbps during 08:00-18:00, with at least 10 hours of power supply duration in outage scenarios."
          }
        },
        "llm": { "script": [ { "$ref": "responses/extract.feasibility.propose.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "promptTextEqualsGolden": "feasibility_propose"
        }
      },
      {
        "step": 2,
        "role": "B",
        "api": "validateProposePromptAndDataFilling",
        "prompt": { "fromStep": 1 },
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 1, "maxRounds": 5 },
        "templateUri": "Negotiation-T/feasibility-negotiation/propose/v1",
        "schema": { "$ref": "schemas/flat" },
        "llm": { "script": [ { "$ref": "responses/semantic.feasibility.accept.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "params": {
            "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3",
            "round": 1,
            "maxRounds": 5,
            "feasibility_result": "achievable"
          }
        }
      },
      {
        "step": 3,
        "role": "B",
        "api": "generateAcceptFromText",
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 1, "maxRounds": 5 },
        "templateUri": "Negotiation-T/feasibility-negotiation/accept-reject/v1",
        "input": {
          "text": {
            "zh-CN": "评估结论：调整后的速率保障目标可以实现并满足停电时长要求，本次可行性协商确认达成一致。",
            "en-US": "Evaluation outcome: the adjusted rate guarantee target is achievable and satisfies the outage duration requirement; this feasibility negotiation is confirmed as concluded."
          }
        },
        "llm": { "script": [ { "$ref": "responses/extract.feasibility.accept.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "promptTextEqualsGolden": "feasibility_accept"
        }
      },
      {
        "step": 4,
        "role": "A",
        "api": "validateAcceptPromptAndDataFilling",
        "prompt": { "fromStep": 3 },
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 1, "maxRounds": 5 },
        "templateUri": "Negotiation-T/feasibility-negotiation/accept-reject/v1",
        "schema": { "$ref": "schemas/flat" },
        "llm": { "script": [ { "$ref": "responses/semantic.feasibility.accept.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "params": {
            "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3",
            "round": 1,
            "maxRounds": 5,
            "feasibility_result": "achievable"
          }
        }
      }
    ],
    "expectFlow": { "terminalCondition": "accept", "roundsUsed": 1, "distinctMessages": true }
  },
