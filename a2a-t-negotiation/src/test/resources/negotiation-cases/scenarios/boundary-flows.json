      },
      {
        "step": 6,
        "role": "B",
        "api": "validateAbortPromptAndDataFilling",
        "prompt": { "fromStep": 5 },
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 3, "maxRounds": 3 },
        "templateUri": "Negotiation-T/common/abort/v1",
        "schema": { "$ref": "schemas/flat" },
        "llm": { "script": [ { "$ref": "responses/semantic.common.abort.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "params": {
            "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3",
            "round": 3,
            "maxRounds": 3,
            "termination_reason": "The negotiation round limit is reached."
          }
        }
      }
