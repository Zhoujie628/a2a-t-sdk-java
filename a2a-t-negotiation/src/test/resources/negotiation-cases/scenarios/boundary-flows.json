[
  {
    "id": "SC-EXH-01",
    "summary": "轮次预算耗尽边界：三轮提议均遭拒绝，round 3 达到 maxRounds 上限后生成终止消息结束协商",
    "languages": ["zh-CN"],
    "roles": ["A", "B"],
    "steps": [
      {
        "step": 1,
        "role": "A",
        "api": "generateProposeFromText",
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 1, "maxRounds": 3 },
        "templateUri": "Negotiation-T/information-negotiation/propose/v1",
        "input": {
          "text": {
            "zh-CN": "请补充节能区域信息（如松山湖）、节能速率保障目标（如20Mbps）与VLANId三项信息，三项之间为或的关系。"
          }
        },
        "llm": { "script": [ { "$ref": "responses/extract.information.propose.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "promptTextEqualsGolden": "information_propose"
        }
      },
      {
        "step": 2,
        "role": "B",
        "api": "generateRejectFromText",
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 1, "maxRounds": 3 },
        "templateUri": "Negotiation-T/information-negotiation/accept-reject/v1",
        "input": {
          "text": {
            "zh-CN": "无法提供节能区域信息：站点库存数据暂不可用，本轮协商拒绝。"
          }
        },
        "llm": { "script": [ { "$ref": "responses/extract.information.reject.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "promptTextEqualsGolden": "information_reject"
        }
      },
      {
        "step": 3,
        "role": "A",
        "api": "generateProposeFromText",
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 2, "maxRounds": 3 },
        "templateUri": "Negotiation-T/information-negotiation/propose/v1",
        "input": {
          "text": {
            "zh-CN": "经内部核实，现仅请求补充节能区域信息（松山湖）与节能速率保障目标（20Mbps）两项，两项之间为且的关系。"
          }
        },
        "llm": {
          "script": [
            "{\"items\":[{\"name\":\"energy-saving area information\",\"value\":\"Songshan Lake\"},{\"name\":\"energy-saving rate guarantee target\",\"value\":\"20Mbps\"}],\"relationship\":\"AND\"}"
          ]
        },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "contracts": ["metadataTripleShape"]
        }
      },
      {
        "step": 4,
        "role": "B",
        "api": "generateRejectFromText",
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 2, "maxRounds": 3 },
        "templateUri": "Negotiation-T/information-negotiation/accept-reject/v1",
        "input": {
          "text": {
            "zh-CN": "仍无法提供节能区域信息：站点库存数据暂不可用，本轮协商再次拒绝。"
          }
        },
        "llm": { "script": [ { "$ref": "responses/extract.information.reject.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "promptTextEqualsGolden": "information_reject"
        }
      },
      {
        "step": 5,
        "role": "A",
        "api": "generateAbortFromText",
        "context": { "id": "3dbc13b5-bd57-4c2b-b503-24e381b6c8d3", "round": 3, "maxRounds": 3 },
        "templateUri": "Negotiation-T/common/abort/v1",
        "input": {
          "text": {
            "zh-CN": "协商轮次已达上限，本次协商确认终止。"
          }
        },
        "llm": { "script": [ { "$ref": "responses/extract.common.abort.full" } ] },
        "expect": {
          "outcome": "success",
          "llmCalls": 1,
          "promptTextEqualsGolden": "abort"
