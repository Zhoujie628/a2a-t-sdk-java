{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openan.net/a2a-t-sdk/negotiation-cases/corpus-schema.json",
  "title": "A2A-T negotiation test corpus format",
  "description": "First-hand definition of the data-driven negotiation test corpus consumed by the negotiation testdata harness (NegotiationCaseLoader and the later CaseEngine suites). Every corpus file is a JSON array of records: case files carry case records, scenario files carry scenario records, and the two shared files carry reusable LLM payloads and JSON Schema variants. The loader parses everything in strict mode, so an unknown key is an error, never a silently ignored typo.",
  "formatVersion": 1,
  "$defs": {
    "language": {
      "title": "Language tag of the bundled negotiation resources",
      "type": "string",
      "enum": ["zh-CN", "en-US"]
    },
    "api": {
      "title": "NegotiationContentService API under test",
      "description": "Exactly the twelve methods of the negotiation content service; the CaseEngine dispatches on this value.",
      "type": "string",
      "enum": [
        "generateProposeFromText",
        "generateAcceptFromText",
        "generateRejectFromText",
        "generateAbortFromText",
        "generateProposeFromData",
        "generateAcceptFromData",
        "generateRejectFromData",
        "generateAbortFromData",
        "validateProposePromptAndDataFilling",
        "validateAcceptPromptAndDataFilling",
        "validateRejectPromptAndDataFilling",
        "validateAbortPromptAndDataFilling"
      ]
    },
    "priority": {
      "title": "Test priority",
      "description": "P0 contract, P1 boundary and retry behavior, P2 rare probes.",
      "type": "string",
      "enum": ["P0", "P1", "P2"]
    },
    "inject": {
      "title": "Harness injection hook",
      "description": "Maps a corpus case onto a real builder injection point; failingTemplateLoader triggers template_not_found on the generation family, failingSemanticValidator replays the missing semantic validation prompt resources of the validate family (mapped onto template_not_found by the validation pipeline).",
      "type": "string",
      "enum": ["failingTemplateLoader", "failingSemanticValidator"]
    },
    "templateUri": {
      "title": "Negotiation template URI",
      "description": "Intentionally permissive: programming-error cases carry deliberately malformed URIs (wrong version segment, wrong extension name, misspelled type, unknown phase).",
      "type": "string",
      "minLength": 1
    },
    "context": {
      "title": "Negotiation context",
      "description": "Inline on every case and every scenario step; scenario steps restate it per step so the round evolution stays visible. A JSON null expresses the null-context probes of the validate family.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "round", "maxRounds"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "maxRounds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "input": {
      "title": "API input",
      "description": "text maps each language to its free-text input; data carries the language-independent typed content of the from-data family. Happy-path from-text cases may carry both for the differential double run.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["text"]
        },
        {
          "required": ["data"]
        }
      ],
      "properties": {
        "text": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/language"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "data": {
          "type": "object"
        }
      }
    },
    "failMarker": {
      "title": "Scripted LLM failure marker",
      "description": "runtime-exception throws an infrastructure error, llm-error answers an LLM error response, null-response returns null, blank-content returns a blank payload, non-json returns an unparseable payload, assertion is the zero-call proof of the from-data and differential runs.",
      "type": "string",
      "enum": ["runtime-exception", "llm-error", "null-response", "blank-content", "non-json", "assertion"]
    },
    "llmScriptStep": {
      "title": "One scripted LLM answer",
      "oneOf": [
        {
          "title": "Shared response reference",
          "description": "Resolves to the named payload in shared/llm-responses.json; the scope is locked to the responses/ prefix.",
          "type": "object",
          "additionalProperties": false,
          "required": ["$ref"],
          "properties": {
            "$ref": {
              "type": "string",
              "pattern": "^responses/\\S+$"
            }
          }
        },
        {
          "title": "Scripted failure",
          "type": "object",
          "additionalProperties": false,
          "required": ["$fail"],
          "properties": {
            "$fail": {
              "$ref": "#/$defs/failMarker"
            }
          }
        },
        {
          "title": "Inline payload",
          "description": "A literal JSON string carrying the payload text verbatim.",
          "type": "string"
        }
      ]
    },
    "llm": {
      "title": "Scripted LLM behavior",
      "description": "maxAttempts is a builder-level value (clamping belongs to the handwritten suites). The script is consumed step by step; exhausting it fails the run instead of repeating the last answer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["script"],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "script": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/llmScriptStep"
          }
        }
      }
    },
    "prompt": {
      "title": "Prompt input of the validate family",
      "description": "Exactly one of the three: a golden fixture name resolved per language, an inline prompt text, or the step whose generated prompt text feeds this validation step.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["golden"],
          "properties": {
            "golden": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fromStep"],
          "properties": {
            "fromStep": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "schemaReference": {
      "title": "Shared schema reference",
      "description": "Resolves to the named JSON Schema variant in shared/schemas.json; the scope is locked to the schemas/ prefix. An inline schema object is also accepted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref"],
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^schemas/\\S+$"
        }
      }
    },
    "slotError": {
      "title": "One expected slot error",
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "code"],
      "properties": {
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expectSuccess": {
      "title": "Success expectation",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "const": "success"
        },
        "llmCalls": {
          "type": "integer",
          "minimum": 0
        },
        "promptTextEqualsGolden": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "templateUriEcho": {
              "type": "string"
            },
            "contextEcho": {
              "type": "boolean"
            }
          }
        },
        "params": {
          "type": "object",
          "description": "Expected merged FilledParamData map; always contains the context keys id, round and maxRounds."
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "differential": {
          "type": "boolean",
          "description": "Marks the from-text plus from-data double run asserting that both outputs equal each other and the golden fixture."
        }
      }
    },
    "expectFailure": {
      "title": "Failure expectation",
      "description": "Discriminated union with the success block: the failure block must name the expected exception type or the expected error code.",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "anyOf": [
        {
          "required": ["exception"]
        },
        {
          "required": ["code"]
        }
      ],
      "properties": {
        "outcome": {
          "const": "failure"
        },
        "exception": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "messageContains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "slotErrors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slotError"
          }
        },
        "llmCalls": {
          "type": "integer",
          "minimum": 0
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expectation": {
      "oneOf": [
        {
          "$ref": "#/$defs/expectSuccess"
        },
        {
          "$ref": "#/$defs/expectFailure"
        }
      ]
    },
    "expectFlow": {
      "title": "Scenario-level expectation",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terminalCondition": {
          "type": "string",
          "enum": ["accept", "reject", "abort", "exhausted"]
        },
        "roundsUsed": {
          "type": "integer",
          "minimum": 1
        },
        "distinctMessages": {
          "type": "boolean"
        }
      }
    },
    "case": {
      "title": "Corpus case record",
      "description": "One fully self-describing test case; key order is fixed (id, api, languages, priority, tags, summary, context, templateUri, input, llm, expect) so diffs stay localized.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "api", "languages", "expect"],
      "properties": {
        "id": {
          "title": "Globally unique case id",
          "description": "Naming syntax: <family>-<category>-<number> such as FT-RETRY-02. The loader expands it per language into id/zh-CN and id/en-US.",
          "type": "string",
          "pattern": "^[A-Z]+(-[A-Z0-9]+)*-[0-9]+$"
        },
        "api": {
          "$ref": "#/$defs/api"
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/language"
          }
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "summary": {
          "title": "Business-facing one-line Chinese summary",
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "templateUri": {
          "$ref": "#/$defs/templateUri"
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "llm": {
          "$ref": "#/$defs/llm"
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        },
        "schema": {
          "oneOf": [
            {
              "$ref": "#/$defs/schemaReference"
            },
            {
              "type": "object"
            }
          ]
        },
        "inject": {
          "$ref": "#/$defs/inject"
        },
        "expect": {
          "$ref": "#/$defs/expectation"
        }
      }
    },
    "scenarioStep": {
      "title": "Scenario step record",
      "description": "A case record plus the three step-level extension keys: the consecutive step number, the acting role and the cross-step prompt reference carried inside prompt.fromStep.",
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "api", "context", "expect"],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "$ref": "#/$defs/api"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "templateUri": {
          "$ref": "#/$defs/templateUri"
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "llm": {
          "$ref": "#/$defs/llm"
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        },
        "schema": {
          "oneOf": [
            {
              "$ref": "#/$defs/schemaReference"
            },
            {
              "type": "object"
            }
          ]
        },
        "inject": {
          "$ref": "#/$defs/inject"
        },
        "expect": {
          "$ref": "#/$defs/expectation"
        }
      }
    },
    "scenario": {
      "title": "Scenario record",
      "description": "A multi-step multi-API interaction over the content layer; every step is a full case record and the scenario adds the step list, the roles and the flow-level expectation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "languages", "steps"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+(-[A-Z0-9]+)*-[0-9]+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/language"
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scenarioStep"
          }
        },
        "expectFlow": {
          "$ref": "#/$defs/expectFlow"
        }
      }
    },
    "caseFile": {
      "title": "Case corpus file",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "scenarioFile": {
      "title": "Scenario corpus file",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "sharedResponsesFile": {
      "title": "Shared LLM response payloads",
      "description": "Flat map of snake_case payload names to literal JSON string payloads; every reusable payload appears exactly once.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9_.]+$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "sharedSchemasFile": {
      "title": "Shared JSON Schema variants",
      "description": "Flat map of schema names to JSON Schema objects referenced through the schemas/ prefix.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9_.]+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/caseFile"
    },
    {
      "$ref": "#/$defs/scenarioFile"
    },
    {
      "$ref": "#/$defs/sharedResponsesFile"
    },
    {
      "$ref": "#/$defs/sharedSchemasFile"
    }
  ]
}
