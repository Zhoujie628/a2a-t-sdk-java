# Copy this file to client.env before starting the a2a-java HTTP+JSON/REST service-recovery sample client.
# Configure any OpenAI LLM endpoint before running the sample client.
# NOTE: local_file mode is required because the classpath prompt-resource loaders currently reject
# full template URIs (e.g. Notification-T/v1/service-recovery) as scenario codes.
A2AT_LANGUAGE=zh-CN
A2AT_PROMPT_SOURCE_TYPE=local_file
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=../../../../../../../a2a-t-resources/src/main/resources/prompt_resources
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=deepseek-chat
A2AT_LLM_BASE_URL=https://api.deepseek.com
A2AT_LLM_API_KEY=
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory
REGISTRY_CENTER_HOST=127.0.0.1
REGISTRY_CENTER_PORT=5001
# Optional: query AgentCard directly from the sample server root instead of registry-center.
A2AT_SAMPLE_HOST=127.0.0.1
A2AT_SAMPLE_PORT=26336
