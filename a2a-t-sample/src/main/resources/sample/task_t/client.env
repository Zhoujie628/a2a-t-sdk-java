# Configure this file to run the Task-T accuracy demo
# (net.openan.a2at.sample.task_t.TaskTDemoMain).
# The demo builds A2ATClient and A2ATServer from the same env file and needs
# an OpenAI-compatible LLM endpoint; fill in a working API key before running.
A2AT_LANGUAGE=zh-CN
A2AT_PROMPT_SOURCE_TYPE=classpath
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=
A2AT_LLM_BASE_URL=
A2AT_LLM_API_KEY=
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory