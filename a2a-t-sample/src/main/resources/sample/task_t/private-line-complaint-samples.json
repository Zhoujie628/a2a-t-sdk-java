{
  "semanticsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "portName": {
        "type": "string",
        "description": "业务字段：接入端口名称，唯一标识被投诉的专线对象",
        "examples": [
          "P781-珠江新城-PTN7900-23-TPA1EG24-17",
          "P781-前海-PTN7900-5-TPA1EG24-09(cvlan=100)"
        ],
        "x-a2at-value-constraint": "物理端口格式为：网元名称-单板号-单板型号-端口号；逻辑端口在末尾追加(cvlan=接入vlanid)"
      },
      "complaintScenario": {
        "type": "string",
        "description": "业务字段：投诉分类场景，专线中断或专线质差二者必选其一",
        "examples": [
          "专线中断",
          "专线质差"
        ],
        "x-a2at-value-constraint": "专线中断（业务完全不通）、专线质差（时延、丢包劣化）"
      },
      "faultStartTime": {
        "type": "string",
        "description": "业务字段：问题发生时间",
        "examples": [
          "2026-05-11T08:21:46Z"
        ],
        "x-a2at-value-constraint": "建议使用 ISO-8601 时间戳，例如 2026-05-11T08:21:46Z"
      },
      "ticketNo": {
        "type": "string",
        "description": "业务字段：OSS 侧受理的投诉工单或事件流水号，供诊断回溯关联",
        "examples": [
          "event-id-20260511-09013"
        ],
        "x-a2at-value-constraint": "例如 event-id-20260511-09013、fault-id-1-017-20260516-11234"
      },
      "faultDetailText": {
        "type": "string",
        "description": "业务字段：用户对故障现象的自由描述，可包含 OSS 侧预处理信息，用于指导诊断方向",
        "examples": [
          "从5月11号早上8点半开始，深圳访问广州的响应时延从平均12ms骤升至320ms"
        ],
        "x-a2at-value-constraint": "预检查信息（测时延、丢包、连通性）与故障现象均可作为详情描述"
      }
    },
    "required": [
      "portName",
      "complaintScenario"
    ]
  },
  "validationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "accessPort": {
        "type": "string",
        "description": "接入端口名称，唯一标识被投诉的专线对象，必填，须与投诉对象一致",
        "examples": [
          "P781-珠江新城-PTN7900-23-TPA1EG24-17",
          "P781-前海-PTN7900-5-TPA1EG24-09(cvlan=100)"
        ],
        "x-a2at-value-constraint": "物理端口格式为：网元名称+单板号+单板型号+端口号；逻辑端口在末尾追加(cvlan=接入vlanid)"
      },
      "bizScenario": {
        "type": "string",
        "description": "投诉分类场景，必填，仅允许取值：专线中断、专线质差",
        "examples": [
          "专线中断",
          "专线质差"
        ],
        "x-a2at-value-constraint": "专线中断（业务完全不通）、专线质差（时延、丢包劣化），二者必选其一"
      },
      "faultTime": {
        "type": "string",
        "description": "问题发生时间",
        "examples": [
          "2026-05-11T08:21:46Z"
        ],
        "x-a2at-value-constraint": "使用 ISO-8601 时间戳，例如 2026-05-11T08:21:46Z"
      },
      "eventSerialNo": {
        "type": "string",
        "description": "OSS 侧受理的投诉工单或事件流水号",
        "examples": [
          "event-id-20260511-09013"
        ],
        "x-a2at-value-constraint": "供诊断回溯关联"
      },
      "faultDetail": {
        "type": "string",
        "description": "投诉/故障现象详情描述",
        "examples": [
          "从5月11号早上8点半开始，深圳访问广州的响应时延从平均12ms骤升至320ms"
        ],
        "x-a2at-value-constraint": "自由描述故障现象，可包含 OSS 侧预处理信息，用于指导诊断方向"
      }
    },
    "required": [
      "accessPort",
      "bizScenario"
    ]
  },
  "samples": [
    {
      "name": "text-private-line-quality",
      "kind": "text",
      "text": "帮我创建专线投诉诊断任务，P781-珠江新城-PTN7900-23-TPA1EG24-17 这个端口，客户报的是专线质差，从2026年5月11号早上8点半开始，深圳访问广州的核心系统非常慢，时延从12ms飙到320ms，柜面和手机银行老是报连接超时，OSS流水号是event-id-20260511-09013。",
      "expected": {
        "accessPort": "P781-珠江新城-PTN7900-23-TPA1EG24-17",
        "bizScenario": "专线质差",
        "faultTime": "2026-05-11",
        "eventSerialNo": "event-id-20260511-09013",
        "faultDetail": "320ms"
      }
    },
    {
      "name": "text-logical-port-interruption",
